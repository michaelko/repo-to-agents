{
  "name": "repo-to-agents",
  "version": "0.1.0",
  "description": "Deterministic repository inspector that generates AI coding-agent instructions.",
  "license": "MIT",
  "author": "Michael Ko",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js"
    }
  },
  "bin": {
    "repo-to-agents": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "agents",
    "ai",
    "cli",
    "copilot",
    "cursor",
    "claude",
    "repository"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelko/repo-to-agents.git"
  },
  "bugs": {
    "url": "https://github.com/michaelko/repo-to-agents/issues"
  },
  "homepage": "https://github.com/michaelko/repo-to-agents#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}
